generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("FACILITATOR") // ADMIN | FACILITATOR | "Business & Ops" | "Product" | "Tech" — the last three see only aspects whose label matches their role
  groupId      String? // Assigned group (a group's id) — the user's "me" participant lives in this group, so their votes land there. Null = no group assigned.
  projectId    String? // Assigned project (a project's id). Label-role users (Tech / Product / Business & Ops) can only score in their assigned project; ADMIN / FACILITATOR work across projects. Null = no project assigned.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  description      String?
  isActive         Boolean           @default(true)
  // Research basis for Desirability (docs/global-setup-sql.md, Step 9):
  // total users per research source in this project. Cash: interview 3,
  // survey 121. DVC: interview 2, survey 123. Null means "not set" — D
  // cannot be computed for a source whose N is missing.
  interviewN       Int?
  surveyN          Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  findings         Finding[]
  groups           Group[]
  frameworkWeights FrameworkWeight[]
  parametersL1     ParameterL1[]
  viabilityAspects ViabilityAspect[]
}

model FrameworkWeight {
  id            String   @id @default(cuid())
  projectId     String
  name          String   // Desirability | Viability | Feasibility
  weight        Float    @default(33.33) // Stored percentage (normalized to 100)
  customFormula String?  // Optional custom formula configuration
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

model Finding {
  id                  String                  @id @default(cuid())
  // Nullable: findings in the global pool belong to no project yet.
  // A pool finding is copied into a project before it can be scored.
  projectId           String?
  title               String
  description         String?
  tags                String                  @default("[]") // JSON string: [{ category: string, value: string }]
  isActive            Boolean                 @default(true)
  feasibilityX        Float?                  // Continuous 0-100% position on X axis (Effort: 0=High, 100=Low or vice versa)
  feasibilityY        Float?                  // Continuous 0-100% position on Y axis (Impact: 0=Low, 100=High)
  feasibilityQuadrant String?                 // BIG_BETS | QUICK_WINS | AVOID | FILL_INS
  feasibilityImpact   String?                 // HIGH | LOW
  feasibilityEffort   String?                 // HIGH | LOW
  // True when the board position was set by dragging the card (a manual
  // pin). False/null means the position is computed from the viewer's
  // D/V/F scores. Added by docs/global-setup-sql.md (Step 8).
  feasibilityManual   Boolean?                @default(false)
  // Research mentions (docs/global-setup-sql.md, Step 9): how many
  // users mentioned this finding in each research source. D is computed
  // from these counts against the project's interviewN/surveyN — never
  // from L3 mappings (removed) or the Sumber/Platform tags.
  interviewMentions   Int?
  surveyMentions      Int?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  project             Project?                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parameterValues     FindingParameterValue[]
  viabilityVotes      ViabilityVote[]
}

// Platform-wide settings (key/value JSON). Used for the GLOBAL DVF
// framework weights (key 'framework_weights'). Supabase-only in
// production; the local Prisma model mirrors the global_settings table.
model GlobalSetting {
  key       String   @id
  value     String // JSON string
  updatedAt DateTime @updatedAt
}

model Group {
  id           String        @id @default(cuid())
  projectId    String
  name         String
  label        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  participants Participant[]
}

model Participant {
  id             String          @id @default(cuid())
  groupId        String
  name           String
  roleTitle      String?
  userId         String? // login User linked to this participant row (the "me" voter); null for facilitator-recorded participants
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  group          Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  viabilityVotes ViabilityVote[]
}

model ViabilityAspect {
  id             String          @id @default(cuid())
  projectId      String
  name           String          // e.g. "Market Demand", "Operational Capacity", "Tech Readiness"
  framework      String          @default("Viability") // Desirability | Viability | Feasibility — the framework dimension this aspect's votes feed
  label          String?         // Business & Ops | Product | Tech — grouping used by the viability scoring formula (stored/display only for now)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viabilityVotes ViabilityVote[]
}

model ViabilityVote {
  id            String          @id @default(cuid())
  findingId     String
  participantId String
  aspectId      String
  isValidated   Boolean         @default(true)
  score         Int? // 1, 2 or 3 — the voter's score for the aspect; null = no score (old boolean-only votes)
  reason        String? // Alasan: the voter's reason for the score, per aspect
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  finding       Finding         @relation(fields: [findingId], references: [id], onDelete: Cascade)
  participant   Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  aspect        ViabilityAspect @relation(fields: [aspectId], references: [id], onDelete: Cascade)

  @@unique([findingId, participantId, aspectId])
}

model ParameterL1 {
  id            String        @id @default(cuid())
  // Nullable: the GLOBAL parameter tree has projectId null and is used
  // by every project. Per-project rows remain as a fallback until the
  // global tree exists (see docs/global-setup-sql.md).
  projectId     String?
  name          String        // Category e.g. "Sumber", "Platform"
  isActive      Boolean       @default(true)
  scoringRules  String        @default("[]") // JSON string: [{ minPercent: number, score: number }]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  project       Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subCategories ParameterL2[]
}

model ParameterL2 {
  id         String        @id @default(cuid())
  l1Id       String
  name       String        // Sub-category e.g. "Wawancara", "Survey"
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   ParameterL1   @relation(fields: [l1Id], references: [id], onDelete: Cascade)
  segments   ParameterL3[]
}

model ParameterL3 {
  id          String                  @id @default(cuid())
  l2Id        String
  name        String                  // Segment e.g. "Cash Management", "Digital Value Chain"
  isActive    Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  subCategory ParameterL2             @relation(fields: [l2Id], references: [id], onDelete: Cascade)
  values      FindingParameterValue[]
}

model FindingParameterValue {
  id        String      @id @default(cuid())
  findingId String
  l3Id      String
  value     String      // Granular item, e.g. "Fitur pengingat otomatis"
  createdAt DateTime    @default(now())
  finding   Finding     @relation(fields: [findingId], references: [id], onDelete: Cascade)
  segment   ParameterL3 @relation(fields: [l3Id], references: [id], onDelete: Cascade)

  @@unique([findingId, l3Id, value])
}
