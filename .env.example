# Supabase Transaction Pooler URL (recommended for Vercel serverless):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (used for migrations and schema push):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# JWT Secret for Admin & Facilitator auth sessions:
JWT_SECRET="enzi-workshop-secret-key-super-secure-change-in-production-2026"

# Optional App URL:
NEXT_PUBLIC_APP_URL="http://localhost:3000"
